---
// src/components/landing/InstrumentPanel.astro
---

<section class="relative mb-80">
  <div class="flex items-center justify-between mb-32 pb-12">
    <h2 class="font-headline text-7xl font-bold uppercase tracking-tighter">
      Project Manager
    </h2>
    <div
      class="font-mono text-[10px] tracking-widest text-on-surface-variant/50"
    >
      V1.0.4_STABLE
    </div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <div
      class="lg:col-span-8 glass-panel instrument-glow rounded-3xl p-12 flex flex-col justify-between relative overflow-hidden group"
    >
      <div class="flex items-center justify-between mb-24">
        <div class="flex items-center gap-4">
          <span
            class="font-mono text-[10px] tracking-[0.3em] text-primary uppercase"
            >PROJECTS // AREAS</span
          >
          <div class="flex gap-1 h-3">
            <div class="w-1 bg-primary"></div>
            <div class="w-1 bg-primary/40"></div>
            <div class="w-1 bg-primary/10"></div>
          </div>
        </div>
        <span
          class="material-symbols-outlined text-primary/20 text-6xl"
          data-icon="sensors">sensors</span
        >
      </div>
      <div>
        <h3
          class="font-headline text-7xl font-bold uppercase mb-8 tracking-tighter"
        >
          Domain Organization
        </h3>
        <p
          class="text-on-surface-variant text-2xl max-w-2xl font-light leading-relaxed"
        >
          Capture voice, text, or visual data at the speed of thought. Zero
          friction, total retention for neural offloading.
        </p>
      </div>
      <div class="mt-20 grid grid-cols-1 md:grid-cols-3 bg-surface-container-highest/20 rounded-xl p-6">
        <div>
          <span
            class="block font-mono text-[9px] text-on-surface-variant mb-2 uppercase tracking-widest"
            >Projects</span
          >
          <span class="font-mono text-primary text-lg">Active</span>
        </div>
        <div>
          <span
            class="block font-mono text-[9px] text-on-surface-variant mb-2 uppercase tracking-widest"
            >Areas</span
          >
          <span class="font-mono text-primary text-lg">Ongoing</span>
        </div>
        <div class="flex justify-end items-center">
          <span
            class="material-symbols-outlined text-primary group-hover:translate-x-4 transition-transform text-4xl"
            data-icon="arrow_forward">arrow_forward</span
          >
        </div>
      </div>
    </div>
    <div
      class="lg:col-span-4 glass-panel instrument-glow rounded-3xl p-10 flex flex-col justify-between relative"
    >
      <div>
        <span
          class="font-mono text-[10px] tracking-[0.3em] text-secondary uppercase mb-16 block"
          >INBOX // CAPTURES</span
        >
        <div class="space-y-6">
          <div
            class="bg-surface-container-highest p-6 rounded-3xl flex justify-between items-center shadow-[0_0_50px_rgba(192,140,247,0.15)]"
          >
            <div>
              <p
                class="font-mono text-[9px] text-secondary mb-2 uppercase tracking-widest"
              >
                PRIORITY_CRITICAL
              </p>
              <p class="font-headline font-bold text-xl">Buy Groceries</p>
            </div>
            <span
              class="material-symbols-outlined text-secondary animate-pulse"
              data-icon="downloading">downloading</span
            >
          </div>
          <div
            class="bg-surface-container-low p-6 rounded-3xl flex justify-between items-center opacity-60"
          >
            <div>
              <p
                class="font-mono text-[9px] text-on-surface-variant mb-2 uppercase tracking-widest"
              >
                SYSTEM_IDLE
              </p>
              <p class="font-headline font-bold text-xl">Read Article</p>
            </div>
          </div>
        </div>
      </div>
      <div
        class="mt-16 bg-black/40 p-6 rounded-lg font-mono text-[10px] text-on-surface-variant"
      >
        <div class="flex justify-between mb-3 tracking-widest">
          <span>INBOX_COUNT</span>
          <span class="text-secondary">ACTIVE</span>
        </div>
        <div class="w-full h-0.75 bg-secondary/10 overflow-hidden">
          <div
            class="w-[75%] h-full bg-secondary shadow-[0_0_30px_rgba(200,140,247,0.5)]"
          >
          </div>
        </div>
      </div>
    </div>
    <div
      class="lg:col-span-5 bg-primary rounded-3xl p-12 flex flex-col justify-between text-on-primary-fixed relative overflow-hidden group shadow-[0_0_80px_rgba(186,158,255,0.2)] lg:translate-y-8"
    >
      <div class="absolute inset-0 noise-bg opacity-10"></div>
      <div>
        <span
          class="font-mono text-[10px] tracking-[0.4em] opacity-50 uppercase mb-20 block"
          >LOCAL_FIRST</span
        >
        <div
          class="text-[10rem] font-headline font-bold leading-none mb-4 group-hover:scale-110 transition-transform duration-700"
        >
          98%
        </div>
        <p class="font-mono font-bold uppercase text-[11px] tracking-[0.4em]">
          SQLite_Database
        </p>
      </div>
      <div class="flex justify-between items-end mt-12">
        <div class="space-y-2">
          <div class="h-0.5 w-20 bg-on-primary-fixed"></div>
          <div class="h-0.5 w-12 bg-on-primary-fixed/40"></div>
        </div>
        <span
          class="material-symbols-outlined text-8xl opacity-30"
          data-icon="bolt"
          style="font-variation-settings: 'FILL' 1;">bolt</span
        >
      </div>
    </div>
    <div
      class="lg:col-span-7 glass-panel instrument-glow rounded-3xl p-12 flex flex-col md:flex-row gap-12 items-center hover:bg-surface-container-highest/30 transition-all"
    >
      <div class="w-full md:w-1/2">
        <span
          class="font-mono text-[10px] tracking-[0.3em] text-secondary uppercase mb-10 block"
          >RELATIONS // TAGS</span
        >
        <h3
          class="font-headline text-5xl font-bold uppercase mb-6 tracking-tight"
        >
          Shared Layers
        </h3>
        <p class="text-on-surface-variant text-lg leading-relaxed font-light">
          Automated surfacing of connected concepts across your entire cognitive
          archive. Finding meaning in the noise.
        </p>
      </div>
      <div
        class="w-full md:w-1/2 h-64 bg-black/60 rounded-2xl flex items-center justify-center p-10 relative overflow-hidden"
      >
        <div class="absolute inset-0 opacity-10">
          <div class="grid grid-cols-6 h-full w-full">
            <div class="bg-secondary/5"></div>
            <div class="bg-transparent"></div>
            <div class="bg-secondary/5"></div>
            <div class="bg-transparent"></div>
            <div class="bg-secondary/5"></div>
            <div class="bg-transparent"></div>
          </div>
        </div>
        <div
          class="grid grid-cols-12 gap-2 items-end w-full h-full relative z-10"
        >
          <div class="bg-secondary/20 h-[30%] rounded-t"></div>
          <div class="bg-secondary/40 h-[50%] rounded-t"></div>
          <div class="bg-secondary/60 h-[80%] rounded-t"></div>
          <div
            class="bg-secondary h-[40%] rounded-t shadow-[0_0_40px_rgba(192,140,247,0.3)]"
          >
          </div>
          <div class="bg-secondary/70 h-[90%] rounded-t"></div>
          <div class="bg-secondary/30 h-[20%] rounded-t"></div>
          <div class="bg-secondary/50 h-[60%] rounded-t"></div>
          <div class="bg-secondary/80 h-[45%] rounded-t"></div>
          <div class="bg-secondary/40 h-[75%] rounded-t"></div>
          <div class="bg-secondary/20 h-[35%] rounded-t"></div>
          <div class="bg-secondary/60 h-[55%] rounded-t"></div>
          <div class="bg-secondary/40 h-[25%] rounded-t"></div>
        </div>
      </div>
    </div>
  </div>
</section>
