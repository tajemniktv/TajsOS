---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';

const title = "TERMS";
---

<Layout>
  <div class="fixed inset-0 noise-bg pointer-events-none z-50"></div>
  <div class="fixed top-[-10%] right-[-5%] w-[600px] h-[600px] gradient-sphere pointer-events-none -z-10"></div>
  
  <Navbar />
  <main class="relative pt-32 max-w-[1600px] mx-auto px-8 min-h-screen">

<!-- Hero Section -->
<section class="mb-24">
    <h1 class="font-headline font-bold text-7xl md:text-9xl tracking-tighter leading-[0.85] text-glow mb-8">
        TERMS
    </h1>
    <p class="font-body text-xl text-on-surface-variant max-w-2xl leading-relaxed">
        Basic rules for using our experimental open-source project.
    </p>
</section>

<section class="max-w-4xl space-y-8 mb-32">
    <div class="glass-panel p-8 rounded-xl border border-outline-variant/10">
        <h2 class="font-headline text-2xl font-bold mb-4">1. Experimental Nature</h2>
        <p class="text-on-surface-variant font-body leading-relaxed">
            TajsOS is provided "AS IS", without warranty of any kind, express or implied. It is an experimental project. We are not responsible for any data loss, bugs, or system crashes that may occur while using the software. Always back up your local database.
        </p>
    </div>

    <div class="glass-panel p-8 rounded-xl border border-outline-variant/10">
        <h2 class="font-headline text-2xl font-bold mb-4">2. Open Source License</h2>
        <p class="text-on-surface-variant font-body leading-relaxed">
            The code is governed by its respective open-source license found in the repository. You are free to use, modify, and distribute it in accordance with those terms.
        </p>
    </div>

    <div class="glass-panel p-8 rounded-xl border border-outline-variant/10">
        <h2 class="font-headline text-2xl font-bold mb-4">3. Hosted Services</h2>
        <p class="text-on-surface-variant font-body leading-relaxed">
            We do not currently provide an official hosted cloud sync service with a Service Level Agreement (SLA). Any sync servers you connect to are your own responsibility to maintain and secure.
        </p>
    </div>
</section>

  </main>
  <Footer />
</Layout>
