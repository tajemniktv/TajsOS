---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';

const title = "WHITEPAPER";
---

<Layout>
  <div class="fixed inset-0 noise-bg pointer-events-none z-50"></div>
  <div class="fixed top-[-10%] right-[-5%] w-[600px] h-[600px] gradient-sphere pointer-events-none -z-10"></div>

  <Navbar />
  <main class="relative pt-32 max-w-[1600px] mx-auto px-8 min-h-screen">

<div class="grid grid-cols-12 gap-16">
<!-- Main Content Area -->
<div class="col-span-12 lg:col-span-8 space-y-32">
<!-- Section I -->
<section class="space-y-10" id="cognitive-architecture">
<div class="flex items-baseline gap-4">
<span class="font-mono text-primary text-xl">I.</span>
<h2 class="font-headline text-5xl font-bold tracking-tight">Cognitive Architecture</h2>
</div>
<div class="prose prose-invert max-w-none space-y-6 text-on-surface-variant leading-relaxed text-lg">
<p>
                            TajsOS operates on a <span class="text-on-surface font-medium italic">tri-layered neural abstraction</span>. Unlike legacy operating systems that rely on linear input-output loops, the NIP leverages a decentralized asynchronous processing mesh designed to mirror biological synaptic firing patterns.
                        </p>
<p>
                            The core kernel, known as the <span class="text-primary font-mono text-base">Cerebral-Root</span>, facilitates the direct mapping of high-order intent into machine-executable protocols without the intermediary of traditional UI metaphors.
                        </p>
</div>
<!-- Technical Diagram Module -->
<div class="bg-surface-container-low rounded-xl p-8 border border-outline-variant/15 relative overflow-hidden">
<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-transparent opacity-50"></div>
<div class="grid grid-cols-3 gap-8 text-center relative z-10">
<div class="space-y-4">
<div class="h-24 flex items-center justify-center">
<div class="w-16 h-16 rounded-full border-2 border-primary/40 flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">psychology</span>
</div>
</div>
<h4 class="font-headline font-bold text-on-surface uppercase tracking-widest text-xs">Intent Capture</h4>
<p class="text-[10px] font-mono text-on-surface-variant">SUB-LATENCY: 0.2ms</p>
</div>
<div class="space-y-4">
<div class="h-24 flex items-center justify-center">
<span class="material-symbols-outlined text-primary-dim text-5xl opacity-40">hub</span>
</div>
<h4 class="font-headline font-bold text-on-surface uppercase tracking-widest text-xs">Bridge Translation</h4>
<p class="text-[10px] font-mono text-on-surface-variant">NIP ENCODING</p>
</div>
<div class="space-y-4">
<div class="h-24 flex items-center justify-center">
<div class="w-16 h-16 rounded-lg border-2 border-primary/20 bg-primary/5 flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">settings_input_component</span>
</div>
</div>
<h4 class="font-headline font-bold text-on-surface uppercase tracking-widest text-xs">Protocol Execution</h4>
<p class="text-[10px] font-mono text-on-surface-variant">KERNEL NATIVE</p>
</div>
</div>
</div>
</section>
<!-- Section II -->
<section class="space-y-10" id="synaptic-bridge">
<div class="flex items-baseline gap-4">
<span class="font-mono text-primary text-xl">II.</span>
<h2 class="font-headline text-5xl font-bold tracking-tight">The Synaptic Bridge</h2>
</div>
<div class="prose prose-invert max-w-none space-y-6 text-on-surface-variant leading-relaxed text-lg">
<p>
                            The Bridge acts as the quantum-resistant tunnel between the biological user and the TajsOS compute engine. By utilizing <span class="text-on-surface font-semibold">Recursive Neural Linking (RNL)</span>, the system achieves a state of digital symbiosis.
                        </p>
</div>
<!-- Code Snippet -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/20 overflow-hidden font-mono text-sm">
<div class="bg-surface-container-high px-6 py-3 border-b border-outline-variant/10 flex justify-between items-center">
<span class="text-[10px] uppercase tracking-widest text-on-surface-variant">nip_initialization.sys</span>
<div class="flex gap-1.5">
<div class="w-2.5 h-2.5 rounded-full bg-error-dim/40"></div>
<div class="w-2.5 h-2.5 rounded-full bg-primary/40"></div>
</div>
</div>
<div class="p-8 leading-relaxed">
<pre class="text-on-surface/80"><span class="text-primary-dim">import</span> &#123; NeuralKernel, Bridge &#125; <span class="text-primary-dim">from</span> <span class="text-primary">'@tajsos/core'</span>;

<span class="text-on-surface-variant">// Initialize the Synaptic Linkage</span>
<span class="text-primary-dim">const</span> syncLink = <span class="text-primary-dim">await</span> Bridge.<span class="text-on-surface">establish</span>(&#123;
    frequency: <span class="text-primary">"40Hz"</span>,
    encryption: <span class="text-primary">"TAJS-9-QUANTUM"</span>,
    calibration: <span class="text-primary-dim">true</span>
&#125;);

<span class="text-on-surface-variant">// Map Cognitive Intent to Protocol</span>
syncLink.<span class="text-on-surface">onIntent</span>((intent) =&gt; &#123;
    <span class="text-primary-dim">if</span> (intent.signature === <span class="text-primary">'SYS_WHITE_PAPER'</span>) &#123;
        NeuralKernel.<span class="text-on-surface">execute</span>(intent.payload);
    &#125;
&#125;);</pre>
</div>
</div>
</section>
<!-- Section III -->
<section class="space-y-10" id="data-sovereignty">
<div class="flex items-baseline gap-4">
<span class="font-mono text-primary text-xl">III.</span>
<h2 class="font-headline text-5xl font-bold tracking-tight">Data Sovereignty</h2>
</div>
<div class="grid grid-cols-2 gap-8">
<div class="p-8 bg-surface-container-low rounded-xl border border-outline-variant/10">
<h3 class="font-headline text-xl font-bold mb-4 text-on-surface">Local-Only Processing</h3>
<p class="text-on-surface-variant text-sm leading-relaxed">No neural data ever leaves the local hardware mesh. TajsOS utilizes edge-only inference to ensure your thoughts remain your own.</p>
</div>
<div class="p-8 bg-surface-container-low rounded-xl border border-outline-variant/10">
<h3 class="font-headline text-xl font-bold mb-4 text-on-surface">Immutable Privacy</h3>
<p class="text-on-surface-variant text-sm leading-relaxed">All cognitive logs are automatically purged after 72ms unless explicitly committed to the long-term vault by the user.</p>
</div>
</div>
</section>
</div>
<!-- Sidebar / Floating Glass Cards -->
<div class="col-span-12 lg:col-span-4 space-y-8 lg:sticky lg:top-32 h-fit">
<!-- Key Terms Card -->
<div class="glass-card inner-glow rounded-xl p-8 space-y-6">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary">menu_book</span>
<h3 class="font-headline font-bold text-sm uppercase tracking-widest">Key Terms</h3>
</div>
<ul class="space-y-4">
<li>
<p class="text-xs font-mono text-primary mb-1 uppercase tracking-tighter">Neuro-Encrypted Mesh</p>
<p class="text-xs text-on-surface-variant leading-relaxed">The physical substrate of the TajsOS network layer.</p>
</li>
<li>
<p class="text-xs font-mono text-primary mb-1 uppercase tracking-tighter">Latency Gap</p>
<p class="text-xs text-on-surface-variant leading-relaxed">The temporal delay between synaptic firing and machine action.</p>
</li>
<li>
<p class="text-xs font-mono text-primary mb-1 uppercase tracking-tighter">Zero-Node Logic</p>
<p class="text-xs text-on-surface-variant leading-relaxed">Computational logic that bypasses central processing nodes.</p>
</li>
</ul>
</div>
<!-- System Requirements Card -->
<div class="glass-card inner-glow rounded-xl p-8 space-y-6">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary">terminal</span>
<h3 class="font-headline font-bold text-sm uppercase tracking-widest">System Specs</h3>
</div>
<div class="space-y-3 font-mono text-[11px] text-on-surface/70">
<div class="flex justify-between border-b border-outline-variant/10 pb-2">
<span>CORES</span>
<span class="text-on-surface">256x NEURAL-X</span>
</div>
<div class="flex justify-between border-b border-outline-variant/10 pb-2">
<span>BANDWIDTH</span>
<span class="text-on-surface">400 TB/s</span>
</div>
<div class="flex justify-between border-b border-outline-variant/10 pb-2">
<span>O-S VERSION</span>
<span class="text-on-surface">TAJS-4.0.2</span>
</div>
</div>
</div>
<!-- Protocol IDs Card -->
<div class="bg-primary/5 rounded-xl p-8 border border-primary/20 space-y-6 relative overflow-hidden">
<div class="absolute -right-4 -bottom-4 opacity-10">
<span class="material-symbols-outlined text-[120px] text-primary">qr_code_2</span>
</div>
<div class="relative z-10">
<h3 class="font-headline font-bold text-sm uppercase tracking-widest text-primary mb-4">Protocol IDs</h3>
<div class="space-y-2">
<code class="block text-[10px] text-on-surface/60 bg-black/30 p-2 rounded">SHA-256: 0x9f2a8c...b231</code>
<code class="block text-[10px] text-on-surface/60 bg-black/30 p-2 rounded">UUID: d54f-12ea-9921-b3b1</code>
</div>
</div>
</div>
</div>
</div>

  </main>
  <Footer />
</Layout>
