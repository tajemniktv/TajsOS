---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';

const title = "SYSTEM STATUS";
---

<Layout>
  <div class="fixed inset-0 noise-bg pointer-events-none z-50"></div>
  <div class="fixed top-[-10%] right-[-5%] w-[600px] h-[600px] gradient-sphere pointer-events-none -z-10"></div>
  
  <Navbar />
  <main class="relative pt-32 max-w-[1600px] mx-auto px-8 min-h-screen">

<!-- Header -->
<header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-16">
  <div class="space-y-2">
    <div class="flex items-center gap-3 px-4 py-1.5 bg-surface-container-low rounded-full border border-outline-variant/10 w-fit">
      <span class="relative flex h-3 w-3">
        <span class="status-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </span>
      <span class="font-mono text-[10px] tracking-[0.2em] text-emerald-400 uppercase font-bold">Project Status // Alpha</span>
    </div>
    <h1 class="text-5xl md:text-7xl font-headline font-bold tracking-tighter text-on-surface">
        Development <br/><span class="text-primary">Roadmap</span>
    </h1>
  </div>
</header>

<!-- Main Info Section -->
<section class="glass-panel p-10 rounded-xl border border-outline-variant/10 mb-16">
  <h2 class="font-headline text-3xl font-bold mb-6 tracking-tight">Current State</h2>
  <div class="space-y-4 font-body text-on-surface-variant text-lg leading-relaxed">
    <p>TajsOS is currently an experimental open-source project in its early Alpha stage. It is built as a local-first personal dashboard/operating system.</p>
    <p>There is currently no hosted cloud infrastructure, no commercial SaaS offering, and no production SLA. You run it yourself.</p>
  </div>
</section>

<!-- Roadmap Items -->
<section class="mb-32">
  <h2 class="font-headline text-4xl font-bold mb-12 tracking-tight">DEVELOPMENT // <span class="text-primary-dim">ROADMAP</span></h2>
  <div class="space-y-6">

    <div class="glass-card p-8 rounded-xl flex items-start gap-6 border-l-4 border-l-emerald-500 bg-surface-container-low/50">
      <span class="material-symbols-outlined text-emerald-400 mt-1">check_circle</span>
      <div>
        <h3 class="font-headline text-xl font-bold mb-2">Phase 1: Local Foundations</h3>
        <p class="text-on-surface-variant font-body">Local SQLite database, core UI architecture, basic task/node management, and experimental Jetpack Compose cross-platform build.</p>
      </div>
    </div>

    <div class="glass-card p-8 rounded-xl flex items-start gap-6 border-l-4 border-l-primary bg-surface-container-low/50">
      <span class="material-symbols-outlined text-primary mt-1">pending</span>
      <div>
        <h3 class="font-headline text-xl font-bold mb-2">Phase 2: Sync Protocol (Current)</h3>
        <p class="text-on-surface-variant font-body">Developing a peer-to-peer or simple self-hosted server synchronization mechanism. Exploring CRDTs and reliable local-first conflict resolution.</p>
      </div>
    </div>

    <div class="glass-card p-8 rounded-xl flex items-start gap-6 border-l-4 border-l-outline-variant bg-surface-container-low/50">
      <span class="material-symbols-outlined text-outline-variant mt-1">construction</span>
      <div>
        <h3 class="font-headline text-xl font-bold mb-2">Phase 3: Extensions & Polish</h3>
        <p class="text-on-surface-variant font-body">Plugin system, advanced data visualization, refined mobile UX, and robust offline support.</p>
      </div>
    </div>

  </div>
</section>

  </main>
  <Footer />
</Layout>
