---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';

const title = "INTERFACE";
---

<Layout>
  <div class="fixed inset-0 noise-bg pointer-events-none z-50"></div>
  <div class="fixed top-[-10%] right-[-5%] w-[600px] h-[600px] gradient-sphere pointer-events-none -z-10"></div>
  
  <Navbar />
  <main class="relative pt-32 max-w-[1600px] mx-auto px-8 min-h-screen">
    
<!-- Header Section -->
<header class="py-16 md:py-24 text-left relative overflow-hidden">
<div class="absolute -left-24 top-0 w-96 h-96 bg-primary-dim/10 blur-[120px] rounded-full"></div>
<h1 class="font-headline text-5xl md:text-8xl font-bold tracking-tighter uppercase leading-none neon-glow-primary">
                INTERFACE<br/><span class="text-primary-dim">OVERVIEW</span>
</h1>
<div class="mt-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
<p class="font-body text-on-surface-variant max-w-xl text-lg leading-relaxed">
                    Visualizing the cognitive mesh network. Manage neural bridges, sync operational states, and monitor real-time pattern recognition diagnostics through the TajsOS unified kernel.
                </p>
<div class="flex gap-4">
<div class="px-4 py-2 bg-surface-container-high border border-outline-variant/20 rounded-lg flex items-center gap-3">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span class="font-mono text-[10px] uppercase tracking-widest text-primary">System Stable</span>
</div>
</div>
</div>
<!-- Bento Grid Section -->
<section class="mt-16 grid grid-cols-1 md:grid-cols-12 gap-6">
<!-- Neural Sync Widget -->
<div class="md:col-span-8 glass-panel p-8 rounded-xl group hover:border-primary/30 transition-all duration-500 relative overflow-hidden">
<div class="absolute top-0 right-0 p-6 opacity-20 group-hover:opacity-40 transition-opacity">
<span class="material-symbols-outlined text-6xl" data-icon="neurology">neurology</span>
</div>
<div class="relative z-10">
<div class="flex items-center gap-3 mb-8">
<span class="material-symbols-outlined text-primary" data-icon="sync_alt">sync_alt</span>
<h3 class="font-headline text-xl font-medium tracking-tight uppercase">Neural Sync</h3>
</div>
<div class="flex flex-col md:flex-row gap-12 items-center">
<div class="relative w-48 h-48 flex items-center justify-center">
<svg class="w-full h-full -rotate-90">
<circle class="text-surface-container-highest" cx="96" cy="96" fill="transparent" r="88" stroke="currentColor" stroke-width="4"></circle>
<circle class="text-primary" cx="96" cy="96" fill="transparent" r="88" stroke="currentColor" stroke-dasharray="552.92" stroke-dashoffset="138" stroke-width="4"></circle>
</svg>
<div class="absolute inset-0 flex flex-col items-center justify-center">
<span class="font-headline text-4xl font-bold">75%</span>
<span class="font-mono text-[10px] uppercase text-on-surface-variant">Coherence</span>
</div>
</div>
<div class="flex-1 space-y-6 w-full">
<div class="space-y-2">
<div class="flex justify-between font-mono text-[10px] uppercase">
<span>Signal Strength</span>
<span class="text-primary">Optimal</span>
</div>
<div class="h-1 bg-surface-container-highest rounded-full overflow-hidden">
<div class="h-full bg-primary w-[92%]"></div>
</div>
</div>
<div class="space-y-2">
<div class="flex justify-between font-mono text-[10px] uppercase">
<span>Latency (ms)</span>
<span>12.4ms</span>
</div>
<div class="h-1 bg-surface-container-highest rounded-full overflow-hidden">
<div class="h-full bg-primary-dim w-[15%]"></div>
</div>
</div>
<div class="flex justify-between items-center pt-4">
<div class="flex items-center gap-2">
<div class="w-10 h-5 bg-surface-container-highest rounded-full relative cursor-pointer border border-outline-variant/30">
<div class="absolute right-1 top-1 w-3 h-3 bg-primary rounded-full"></div>
</div>
<span class="font-mono text-[10px] uppercase text-on-surface-variant">Auto-Calibration</span>
</div>
<button class="px-6 py-2 bg-primary text-on-primary-fixed font-headline font-bold text-xs uppercase rounded-lg hover:shadow-[0_0_20px_rgba(186,158,255,0.4)] transition-all">
                                    Initiate Resync
                                </button>
</div>
</div>
</div>
</div>
</div>
<!-- Focus Timer Widget -->
<div class="md:col-span-4 glass-panel p-8 rounded-xl flex flex-col justify-between hover:border-primary/30 transition-all duration-500 bg-gradient-to-br from-surface-container-high to-surface">
<div>
<div class="flex items-center justify-between mb-8">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary" data-icon="timer">timer</span>
<h3 class="font-headline text-xl font-medium tracking-tight uppercase">Focus</h3>
</div>
<span class="material-symbols-outlined text-on-surface-variant cursor-pointer hover:text-primary transition-colors" data-icon="more_vert">more_vert</span>
</div>
<div class="text-center py-6">
<div class="font-headline text-6xl font-light tracking-widest text-[#fcf8fe]">24:00</div>
<p class="font-mono text-[10px] text-on-surface-variant uppercase mt-2 tracking-widest">Deep Work Protocol Active</p>
</div>
</div>
<div class="grid grid-cols-2 gap-3 mt-8">
<button class="py-3 bg-surface-container-highest border border-outline-variant/20 rounded-lg font-headline text-xs uppercase font-bold hover:bg-surface-container-high transition-colors">Reset</button>
<button class="py-3 bg-primary text-on-primary-fixed rounded-lg font-headline text-xs uppercase font-bold hover:brightness-110 transition-all">Pause</button>
</div>
</div>
<!-- Pattern Recognition Graph -->
<div class="md:col-span-12 glass-panel p-8 rounded-xl hover:border-primary/30 transition-all duration-500 overflow-hidden">
<div class="flex items-center justify-between mb-10">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary" data-icon="monitoring">monitoring</span>
<h3 class="font-headline text-xl font-medium tracking-tight uppercase">Pattern Recognition Analytics</h3>
</div>
<div class="flex gap-4">
<span class="font-mono text-[10px] text-on-surface-variant uppercase flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-primary"></span> Cognition
                        </span>
<span class="font-mono text-[10px] text-on-surface-variant uppercase flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-tertiary"></span> External Bias
                        </span>
</div>
</div>
<div class="h-64 w-full flex items-end gap-1 relative">
<div class="absolute inset-0 flex flex-col justify-between py-2 opacity-10">
<div class="w-full h-px bg-white"></div>
<div class="w-full h-px bg-white"></div>
<div class="w-full h-px bg-white"></div>
<div class="w-full h-px bg-white"></div>
</div>
<!-- Simplified bar chart logic -->
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[40%] rounded-t-sm relative group">
<div class="absolute -top-8 left-1/2 -translate-x-1/2 font-mono text-[9px] text-primary opacity-0 group-hover:opacity-100 transition-opacity">0.42</div>
</div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[65%] rounded-t-sm relative group">
<div class="absolute -top-8 left-1/2 -translate-x-1/2 font-mono text-[9px] text-primary opacity-0 group-hover:opacity-100 transition-opacity">0.65</div>
</div>
<div class="flex-1 bg-primary/40 hover:bg-primary/60 transition-colors h-[85%] rounded-t-sm relative group">
<div class="absolute -top-8 left-1/2 -translate-x-1/2 font-mono text-[9px] text-primary opacity-0 group-hover:opacity-100 transition-opacity">0.85</div>
</div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[50%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-tertiary/20 hover:bg-tertiary/40 transition-colors h-[30%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[55%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[75%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-tertiary/20 hover:bg-tertiary/40 transition-colors h-[45%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[92%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[60%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[40%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[80%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-tertiary/20 hover:bg-tertiary/40 transition-colors h-[25%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[68%] rounded-t-sm relative group"></div>
<div class="flex-1 bg-primary/20 hover:bg-primary/40 transition-colors h-[44%] rounded-t-sm relative group"></div>
</div>
<div class="mt-4 flex justify-between font-mono text-[9px] text-on-surface-variant uppercase tracking-widest">
<span>00:00 - Init</span>
<span>12:00 - Mid Peak</span>
<span>23:59 - Terminal</span>
</div>
</div>
</section>
<!-- Technical Section: Protocol Documentation -->
<section class="mt-24">
<div class="flex flex-col md:flex-row gap-12">
<div class="md:w-1/3">
<h2 class="font-headline text-3xl font-bold uppercase tracking-tight mb-6">Protocol<br/>Documentation</h2>
<p class="font-body text-on-surface-variant mb-8 text-sm leading-relaxed">
                        Access raw kernel streams and interface protocols. Each module represents a core directive of the TajsOS cognitive layer.
                    </p>
<div class="space-y-4">
<div class="flex items-center justify-between p-4 bg-surface-container-low rounded-lg border border-outline-variant/10">
<span class="font-mono text-xs uppercase">Auth-Shield-V2</span>
<span class="px-2 py-1 bg-primary/10 text-primary text-[9px] font-bold rounded uppercase">Active</span>
</div>
<div class="flex items-center justify-between p-4 bg-surface-container-low rounded-lg border border-outline-variant/10">
<span class="font-mono text-xs uppercase">Neuro-Linker</span>
<span class="px-2 py-1 bg-tertiary/10 text-tertiary text-[9px] font-bold rounded uppercase">Standby</span>
</div>
<div class="flex items-center justify-between p-4 bg-surface-container-low rounded-lg border border-outline-variant/10">
<span class="font-mono text-xs uppercase">Data-Siphon</span>
<span class="px-2 py-1 bg-surface-container-highest text-on-surface-variant text-[9px] font-bold rounded uppercase">Off</span>
</div>
</div>
</div>
<div class="md:w-2/3 glass-panel rounded-xl overflow-hidden flex flex-col h-[450px]">
<div class="bg-surface-container-highest px-6 py-3 flex items-center justify-between">
<div class="flex gap-2">
<div class="w-3 h-3 rounded-full bg-error-dim/40"></div>
<div class="w-3 h-3 rounded-full bg-primary-dim/40"></div>
<div class="w-3 h-3 rounded-full bg-on-surface-variant/40"></div>
</div>
<span class="font-mono text-[10px] text-on-surface-variant uppercase">interface_bridge.ts</span>
</div>
<div class="p-8 font-mono text-sm overflow-y-auto protocol-scroll bg-surface-container-lowest/50">
<pre class="text-primary-dim"><span class="text-tertiary">import</span> &#123; NeuralBridge, KernelState &#125; <span class="text-on-surface-variant">from</span> <span class="text-primary">"@tajsos/core"</span>;</pre>
<pre class="mt-4"><span class="text-on-surface-variant">// Initialize Interface Hook</span></pre>
<pre><span class="text-tertiary">async function</span> <span class="text-primary">initializeBridge</span>(dna: <span class="text-secondary">string</span>) &#123;</pre>
<pre>  <span class="text-tertiary">const</span> bridge = <span class="text-tertiary">new</span> <span class="text-secondary">NeuralBridge</span>(&#123;</pre>
<pre>    frequency: <span class="text-primary">"432Hz"</span>,</pre>
<pre>    stabilityThreshold: <span class="text-primary">0.85</span>,</pre>
<pre>    encryption: <span class="text-primary">"NEURAL-X64"</span></pre>
<pre>  &#125;);</pre>
<pre class="mt-4">  <span class="text-tertiary">try</span> &#123;</pre>
<pre>    <span class="text-tertiary">await</span> bridge.<span class="text-primary">connect</span>();</pre>
<pre>    <span class="text-on-surface-variant">console</span>.<span class="text-primary">log</span>(<span class="text-primary">"LINK_ESTABLISHED"</span>);</pre>
<pre>    <span class="text-tertiary">return</span> bridge.<span class="text-primary">stream</span>();</pre>
<pre>  &#125; <span class="text-tertiary">catch</span> (err) &#123;</pre>
<pre>    <span class="text-error">throw new Error</span>(<span class="text-primary">"COGNITIVE_DESYNC"</span>);</pre>
<pre>  &#125;</pre>
<pre>&#125;</pre>
<pre class="mt-4"><span class="text-tertiary">export const</span> TajsBridge = <span class="text-primary">initializeBridge</span>(<span class="text-primary">"SYS_ALPHA_001"</span>);</pre>
</div>
</div>
</div>
</section>
<!-- Visual Elements / Abstract Content -->
<section class="mt-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
<div class="order-2 md:order-1">
<h3 class="font-headline text-2xl font-bold uppercase tracking-tight mb-4">The Neural Infrastructure</h3>
<p class="font-body text-on-surface-variant leading-relaxed">
                    TajsOS utilizes an asymmetric processing grid that mimics the synaptic behavior of the human brain. Every interaction is weighted, contextualized, and stored in the "Second Brain" repository for long-term cognitive synthesis.
                </p>
<div class="mt-8 grid grid-cols-2 gap-4">
<div class="p-6 bg-surface-container-low rounded-lg group hover:bg-primary/5 transition-colors cursor-default">
<span class="material-symbols-outlined text-primary mb-3" data-icon="hub">hub</span>
<h4 class="font-headline text-xs font-bold uppercase">Dynamic Nodes</h4>
<p class="text-[10px] text-on-surface-variant mt-1">Self-healing data pathways.</p>
</div>
<div class="p-6 bg-surface-container-low rounded-lg group hover:bg-primary/5 transition-colors cursor-default">
<span class="material-symbols-outlined text-primary mb-3" data-icon="terminal">terminal</span>
<h4 class="font-headline text-xs font-bold uppercase">Kernel Sync</h4>
<p class="text-[10px] text-on-surface-variant mt-1">Direct hardware integration.</p>
</div>
</div>
</div>
<div class="order-1 md:order-2 flex justify-center">
<div class="relative w-full aspect-square max-w-md">
<div class="absolute inset-0 bg-primary/20 blur-[80px] rounded-full animate-pulse"></div>
<img alt="Futuristic Neural UI" class="w-full h-full object-cover rounded-2xl grayscale hover:grayscale-0 transition-all duration-700 opacity-60 border border-primary/20 p-2" data-alt="Abstract glowing purple neural network circuits visualization" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAok-swCeTVs7GThQ4K775Fat8Pm5VJ0hZFLqagonDYayL7PeybnQaujp33ySfZDF9IgjcisSwNqUrv8_EEGG1W96EzwY3vfaJDF2XgjPblYbIMSxrFSJLzMu7Nt1-cZAkD6TCPxPIf4t0ww1nK93PU5W78JM226cqykv6zh1ci9IjSjMqVLAw_Sm4twxUBxGh42Wis8OXSUXMZ4VD2WPLEsTuZfIqPqGCNtdo1jNJZ3tTU7A32rM0YgZvfR2nBwdR31JA1KcScVjU"/>
</div>
</div>
</section>
</header>
  </main>
  <Footer />
</Layout>
