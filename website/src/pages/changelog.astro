---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';

const title = "Changelog";
---

<Layout title={title}>
  <div class="fixed inset-0 noise-bg pointer-events-none z-50"></div>
  <div class="fixed top-[-10%] right-[-5%] w-[600px] h-[600px] gradient-sphere pointer-events-none -z-10"></div>
  
  <Navbar />
  <main class="relative pt-32 max-w-[1600px] mx-auto px-8 min-h-screen">

<!-- Header -->
<header class="mb-24">
    <h1 class="font-headline font-bold text-7xl md:text-9xl tracking-tighter text-on-surface glow-text mb-6">
        CHANGELOG
    </h1>
    <p class="font-body text-xl text-on-surface-variant max-w-2xl leading-relaxed">
        Tracking the development progress of TajsOS.
    </p>
</header>

<div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-32">
    <!-- Main Log -->
    <div class="md:col-span-8 space-y-12">

        <article class="glass-panel p-8 rounded-xl relative">
            <div class="absolute -left-3 top-10 w-6 h-6 rounded-full bg-primary flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-surface"></div>
            </div>
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
                <h2 class="font-headline text-3xl font-bold text-primary">Alpha 0.1.0</h2>
                <span class="font-mono text-sm text-on-surface-variant bg-surface-container px-3 py-1 rounded-full border border-outline-variant/20">Early 2024</span>
            </div>
            <div class="prose prose-invert prose-p:text-on-surface-variant max-w-none">
                <p>Initial foundation laid for the local-first personal dashboard.</p>
                <ul>
                    <li><strong>Feature:</strong> Jetpack Compose Multiplatform UI structure created.</li>
                    <li><strong>Feature:</strong> SQLite local database integration using Room.</li>
                    <li><strong>Feature:</strong> Basic Node and Protocol (task management) UI.</li>
                    <li><strong>Experiment:</strong> Setup rudimentary Ktor server for future sync tests.</li>
                </ul>
            </div>
        </article>

        <article class="glass-panel p-8 rounded-xl relative opacity-80">
            <div class="absolute -left-3 top-10 w-6 h-6 rounded-full bg-surface-container-high border-2 border-primary/50 flex items-center justify-center">
                <div class="w-2 h-2 rounded-full bg-primary/50"></div>
            </div>
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
                <h2 class="font-headline text-3xl font-bold">Project Inception</h2>
                <span class="font-mono text-sm text-on-surface-variant bg-surface-container px-3 py-1 rounded-full border border-outline-variant/20">Late 2023</span>
            </div>
            <div class="prose prose-invert prose-p:text-on-surface-variant max-w-none">
                <p>Exploration of local-first patterns, UI mockups, and architectural planning.</p>
            </div>
        </article>
    </div>

    <!-- Sidebar -->
    <aside class="md:col-span-4">
        <div class="glass-panel p-6 rounded-xl border border-outline-variant/10 sticky top-32">
            <h3 class="font-headline text-xl font-bold mb-4">Development Log</h3>
            <p class="text-sm text-on-surface-variant mb-6 leading-relaxed">
                TajsOS is currently developed in bursts. This log tracks major milestones and architectural shifts rather than every minor commit.
            </p>
            <a href="https://github.com/tajemniktv/TajsOS" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary-dim transition-colors text-sm font-bold flex items-center gap-2">
                View GitHub Commits <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
        </div>
    </aside>
</div>

  </main>
  <Footer />
</Layout>
